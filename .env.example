APP_ENV=demo
DATABASE_URL=sqlite:///./hospital_ai.db
REDIS_URL=redis://localhost:6379/0

# Optional local MinIO/S3-style inbox. The default demo uses filesystem PDFs.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=referral-demo-inbox
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio123

REFERRAL_INBOX_BACKEND=filesystem
REFERRAL_INBOX_DIR=./data/referral_inbox
REFERRAL_INBOX_MAX_UPLOAD_BYTES=20971520
DEMO_PRELOAD_REFERRALS=true
DEMO_PRELOAD_REFERRALS_DIR=./demos/referral_inbox_samples
LOCAL_MODEL_CONFIG_PATH=./data/local_model_config.json

AUTH_MODE=demo

# Real local/OpenAI-compatible Gemma endpoint.
MODEL_PROVIDER=gemma_vllm
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_API_KEY=local-demo
LOCAL_LLM_TIMEOUT_SECONDS=0
LOCAL_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,model-server
GENERATION_MODEL_ID=google/gemma-4-31B-it
GENERATION_MAX_TOKENS=2048

# Local retrieval default. No external model download is required.
# For EmbeddingGemma, set EMBEDDING_PROVIDER=embeddinggemma_local and LOCAL_EMBEDDING_MODEL_PATH.
EMBEDDING_PROVIDER=lexical_only
EMBEDDING_MODEL_ID=google/embeddinggemma-300m
LOCAL_EMBEDDING_MODEL_PATH=
EMBEDDING_LOCAL_FILES_ONLY=true

RAG_TOP_K=20
RAG_CONTEXT_TOP_N=3
RAG_MIN_RELEVANCE_SCORE=0.18
RAG_LEXICAL_WEIGHT=1.0
RAG_VECTOR_WEIGHT=0.0
GUIDELINE_EXTRACTIVE_MODE=true
MAX_GUIDELINE_QUESTION_CHARS=2000
MAX_REFERRAL_TEXT_CHARS=50000

OCR_ENABLED=true
OCR_LANGUAGES=deu+eng
OCR_DPI=300
OCR_MIN_TEXT_CHARS=24
OCR_MIN_CONFIDENCE=0.75

NO_EXTERNAL_AI_CALLS=true
STORE_PROMPT_TEXT=false
STORE_MODEL_OUTPUT_TEXT=false
AUDIT_LOG_ENABLED=true
WRITEBACK_ENABLED=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
